# Jelly copy of the Youry Discord bot — create a NEW Discord application.
# Do not reuse the Youry bot token.
# Token = onglet Bot → Reset Token (PAS la clé publique, PAS l'ID d'application)
# Bot token only (Bot tab -> Reset Token). Not the application ID or public key.
DISCORD_TOKEN=your_bot_token_here

# true = sync all channels on startup (skips unchanged; défaut: false)
AUTO_PUBLISH_ON_START=false

# Registration notifications with Validate / Reject (default: registration_log_channel in channel_config.json)
# REGISTRATION_LOG_CHANNEL_ID=1546459928049356800
# Role granted on apply (default: creator_role_id in channel_config.json). Bot needs Manage Roles.
# CREATOR_ROLE_ID=1562457257093103716
# Staff role for /username, review buttons, AI escalation pings (default: NOTIFY_ROLE_ID)
# STAFF_ROLE_ID=

# Payment proof drip: one new image from assets/payout_proofs every N hours (default 48)
# PAYMENT_PROOF_CHANNEL_ID=1546459879462408252
# PAYMENT_PROOF_INTERVAL_HOURS=48

# AI ticket assistant (ticket-* channels). One key is enough; OpenAI is used first.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5
# AI_PROVIDER=openai
# TICKET_CHANNEL_PREFIX=ticket-
# Learnings are mirrored here and rebuilt from it on startup (default: registration log channel)
# SUPPORT_LEARNING_CHANNEL_ID=

# Persona (/persona): Speel "Corpo Girl" workflow API. Same secret as PERSONA_API_SECRET on Speel.
# SPEEL_API_URL=https://your-speel-app.example.com
# PERSONA_API_SECRET=

# Staff feeds (defaults in channel_config.json)
# DISCORD_JOIN_LOG_CHANNEL_ID=1510936933575163984
# CONTENT_GENERATION_LOG_CHANNEL_ID=1546459928049356800

# JobShift Creators — signup notifications (defaults in channel_config.json)
# CREATORS_GUILD_ID=1540823867818385468
# CREATOR_SIGNUP_LOG_CHANNEL_ID=1547101182680629268
# CREATOR_DISCORD_INVITE_URL=https://discord.gg/xxxx
# CREATOR_SIGNUP_WEBHOOK_PORT=8080
# CREATOR_SIGNUP_WEBHOOK_SECRET=your_shared_secret
# Also serves POST /webhooks/creator-application for finished /creators/apply forms.
# NOTIFY_USER_IDS=1015244275354706002
# NOTIFY_ROLE_ID=

# Optional — full path to ffmpeg.exe if not found on PATH (WinGet installs often need this)
# FFMPEG_PATH=C:\Users\you\AppData\Local\Microsoft\WinGet\Packages\...\bin\ffmpeg.exe

# /cleanvideo, /videoinfo, /varyimage — no extra config needed (uses ffmpeg above).
# Optional AI image remix for carousel slides + /varyimage ai:true (fal.ai key):
# FAL_KEY=your_fal_ai_key
# Opt-in: let "ai" join the random carousel augment pool (crop/grade/grain/prop/ai).
# Off by default even with FAL_KEY set, since each carousel can call fal.ai up to 4x.
# CAROUSEL_AI_VARIATION=false

# One-off Whop broadcast (scripts/whop_discord_broadcast.py) — delete script after use
# WHOP_API_KEY=your_company_api_key
# WHOP_COMPANY_ID=biz_xxxxxxxxxxxxxx
# WHOP_ACTOR_USER_ID=user_xxxxxxxxxxxxxx  # optional; defaults to admin member
# Email export also needs member:email:read on the API key
