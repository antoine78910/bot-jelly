# Jelly copy of the Youry Discord bot — create a NEW Discord application.
# Do not reuse the Youry bot token.
# Token = onglet Bot → Reset Token (PAS la clé publique, PAS l'ID d'application)
# Bot token only (Bot tab -> Reset Token). Not the application ID or public key.
DISCORD_TOKEN=your_bot_token_here

# true = sync all channels on startup (skips unchanged; défaut: false)
AUTO_PUBLISH_ON_START=false

# Salon où arrivent les inscriptions (défaut: channel_config.json)
REGISTRATION_LOG_CHANNEL_ID=1509831488244547625

# Staff feeds (defaults in channel_config.json)
# DISCORD_JOIN_LOG_CHANNEL_ID=1510936933575163984
# CONTENT_GENERATION_LOG_CHANNEL_ID=1510937017582620672

# JobShift Creators — signup notifications (defaults in channel_config.json)
# CREATORS_GUILD_ID=1540823867818385468
# CREATOR_SIGNUP_LOG_CHANNEL_ID=1547101182680629268
# CREATOR_DISCORD_INVITE_URL=https://discord.gg/xxxx
# CREATOR_SIGNUP_WEBHOOK_PORT=8080
# CREATOR_SIGNUP_WEBHOOK_SECRET=your_shared_secret

# Optional — full path to ffmpeg.exe if not found on PATH (WinGet installs often need this)
# FFMPEG_PATH=C:\Users\you\AppData\Local\Microsoft\WinGet\Packages\...\bin\ffmpeg.exe

# One-off Whop broadcast (scripts/whop_discord_broadcast.py) — delete script after use
# WHOP_API_KEY=your_company_api_key
# WHOP_COMPANY_ID=biz_xxxxxxxxxxxxxx
# WHOP_ACTOR_USER_ID=user_xxxxxxxxxxxxxx  # optional; defaults to admin member
# Email export also needs member:email:read on the API key
